<Window x:Class="SakuraCamp.Preview.PreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SakuraCamp.Preview" Title="樱火营地 · 饥荒风格参考（非正式版）" Width="1260" Height="880" MinWidth="1080" MinHeight="740" Background="#1A1916" Foreground="#DCD3B8" FontFamily="KaiTi, Microsoft YaHei UI" FontSize="16" WindowStartupLocation="CenterScreen">
<WindowChrome.WindowChrome><WindowChrome CaptionHeight="86" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
<Window.Resources>
<SolidColorBrush x:Key="Paper" Color="#DBCFAD"/><SolidColorBrush x:Key="Faded" Color="#A49A81"/>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
<Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="Foreground" Value="#E7DCC0"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#D0C19B"/><Setter Property="Foreground" Value="#24231E"/><Setter Property="Padding" Value="22,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><local:RoughFrame x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="#8C7950" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></local:RoughFrame><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#F0DDA8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#AE9462"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#141511"/><Setter Property="Foreground" Value="#E0D5B7"/><Setter Property="BorderBrush" Value="#74684C"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,6,0,16"/><Setter Property="FontSize" Value="15"/></Style>
<Style TargetType="ComboBox"><Setter Property="Background" Value="#292820"/><Setter Property="Foreground" Value="#E3D5B0"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="#171913" Foreground="#DFD2AD" BorderBrush="#75684B" BorderThickness="1" Padding="10,10" HorizontalContentAlignment="Stretch"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="10"><Grid><ContentPresenter Margin="0,0,22,0"/><TextBlock Text="▾" HorizontalAlignment="Right" Foreground="#C1AC74"/></Grid></Border></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate,RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentStringFormat="{Binding SelectionBoxItemStringFormat,RelativeSource={RelativeSource AncestorType=ComboBox}}"/></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#24241D" BorderBrush="#9E8858" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260"><ScrollViewer CanContentScroll="False"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="#E0D6BD"/><Setter Property="Background" Value="#24241D"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#655A3C"/></Trigger></Style.Triggers></Style></Setter.Value></Setter></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="#B5AA8C"/><Setter Property="FontSize" Value="18"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Grid Margin="0,0,20,0"><TextBlock x:Name="Label" Text="{TemplateBinding Header}" Padding="8,14"/><Path x:Name="Underline" Data="M 0,0 L 42,1 L 91,0" Stroke="#BEA66D" StrokeThickness="2" VerticalAlignment="Bottom" Visibility="Hidden"/></Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Label" Property="Foreground" Value="#F5D994"/><Setter TargetName="Underline" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Label" Property="Foreground" Value="#EBDCB9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#80724D" Margin="3,2" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ScrollViewer"><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
<Style TargetType="local:RoughFrame"><Setter Property="Background" Value="#27271F"/><Setter Property="BorderBrush" Value="#74684A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18"/></Style>
</Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition/><RowDefinition Height="44"/></Grid.RowDefinitions><local:PaperGrain Grid.RowSpan="3" IsHitTestVisible="False"/>
<Grid Margin="30,12,24,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:RoughFrame Background="#D5C294" Padding="10,2" Margin="0,0,15,0" BorderBrush="#74684A" BorderThickness="1"><TextBlock Text="营" Foreground="#211E18" FontSize="30"/></local:RoughFrame><StackPanel><TextBlock Text="樱 火 营 地" FontSize="29"/><TextBlock Text="SAKURA CAMP  ·  荒野手册" FontFamily="Georgia" FontSize="11" Foreground="#B1A17C"/></StackPanel></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"><TextBlock Text="饥荒风格 · 界面参考" Foreground="#C2B48F" HorizontalAlignment="Right"/><TextBlock Text="独立测试包 / 不计入正式版本" Foreground="#817962" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,-10,-20,0"><Button Content="—" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" Padding="8,0" FontSize="12" Background="Transparent" Foreground="#B7AE96"/><Button Content="□" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" Padding="8,0" FontSize="12" Background="Transparent" Foreground="#B7AE96"/><Button Content="×" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" Padding="8,0" FontSize="14" Background="Transparent" Foreground="#B7AE96"/></StackPanel></Grid>
<TabControl x:Name="Pages" Grid.Row="1" Margin="28,14,28,12" Background="Transparent" BorderThickness="0" Padding="0,22,0,0">
<TabItem Header="世界总览"><ScrollViewer><StackPanel><TextBlock Text="选择你的荒野" Style="{StaticResource Caption}"/><TextBlock Text="火光以外，是另一个故事。" Foreground="#A79A7B" Margin="0,0,0,26"/><WrapPanel>
<local:RoughFrame Width="350" Margin="0,0,20,20" Background="#27271F" BorderBrush="#74684A" BorderThickness="1" Padding="18"><StackPanel><local:WildernessScene Height="150"/><TextBlock Text="桦树林里的营火" FontSize="23" Margin="0,16,0,8"/><TextBlock Text="地上与洞穴  ·  6 人  ·  生存模式" Foreground="#A4987B" FontSize="14"/><Button Content="✓  当前世界" Margin="0,20,0,0" Click="SelectWorld_Click"/></StackPanel></local:RoughFrame>
<local:RoughFrame Width="350" Margin="0,0,20,20" Background="#27271F" BorderBrush="#74684A" BorderThickness="1" Padding="18"><StackPanel><local:WildernessScene Height="150" IsCave="True"/><TextBlock Text="萤火虫与旧矿灯" FontSize="23" Margin="0,16,0,8"/><TextBlock Text="地上与洞穴  ·  8 人  ·  无尽模式" Foreground="#A4987B" FontSize="14"/><Button Content="选择这个世界" Margin="0,20,0,0" Click="SelectWorld_Click"/></StackPanel></local:RoughFrame>
</WrapPanel></StackPanel></ScrollViewer></TabItem>
<TabItem Header="联机设置"><ScrollViewer><StackPanel><Grid Margin="0,0,0,24"><StackPanel><TextBlock Text="点亮营火，等朋友来" Style="{StaticResource Caption}"/><TextBlock Text="桦树林里的营火  /  示例世界" Foreground="#A79A7B"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="DemoStart" Content="点亮营火 · 开服演示" Click="DemoStart_Click"/><Button Content="保存关服" Click="DemoStop_Click" Background="#343229" Foreground="#D6C9A6"/></StackPanel></Grid><local:RoughFrame Background="#27271F" BorderBrush="#74684A" BorderThickness="1" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="樱花访问密钥"/><TextBox Text="仅为样式示例，无需填写真实密钥" IsReadOnly="True"/><TextBlock Text="科雷独立服务器令牌"/><TextBox Text="示例令牌" IsReadOnly="True"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="樱花节点"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="上海 · 示例营地"/><ComboBoxItem Content="杭州 · 示例营地"/><ComboBoxItem Content="广州 · 示例营地"/></ComboBox><TextBlock Text="服务器密码（可选）" Margin="0,8,0,0"/><TextBox Text=""/></StackPanel></Grid></local:RoughFrame><WrapPanel Margin="0,24,0,0"><Button Content="复制朋友连接命令" Click="CopyDemo_Click"/><Button Content="复制房主连接命令" Click="CopyDemo_Click" Background="#343229" Foreground="#D6C9A6"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
<TabItem Header="世界规则"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="荒野的法则" Style="{StaticResource Caption}"/><TextBlock Text="主世界与洞穴各自配置。以下选择仅用于界面演示。" Foreground="#A79A7B" Margin="0,0,0,22"/></StackPanel><WrapPanel Grid.Row="1" Margin="0,0,0,20"><Button Content="主世界" Click="Master_Click"/><Button Content="洞穴" Click="Caves_Click" Background="#343229" Foreground="#D6C9A6"/><TextBlock x:Name="RuleLocation" Text="—  主世界  —" Foreground="#9C8D69" Margin="15,0,0,0"/></WrapPanel><ScrollViewer Grid.Row="2"><ItemsControl x:Name="RuleCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><local:RoughFrame Width="340" Margin="0,0,18,18" Background="#27271F" BorderBrush="#74684A" BorderThickness="1" Padding="18"><StackPanel><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="66" Height="66" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="21"/></Grid><ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedIndex="0" Margin="0"><ComboBox.Resources><DataTemplate DataType="{x:Type local:PreviewRuleChoice}"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.Resources></ComboBox></StackPanel></local:RoughFrame></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></TabItem>
<TabItem Header="Mod 管理"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,0,0,24"><TextBlock Text="带上你的生存工具" Style="{StaticResource Caption}"/><TextBlock Text="服务器模组  /  开关与齿轮仅展示交互，不写入真实世界。" Foreground="#A79A7B"/></StackPanel><ScrollViewer Grid.Row="1"><ItemsControl x:Name="ModCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><local:RoughFrame Width="340" Margin="0,0,18,18" Background="#27271F" BorderBrush="#74684A" BorderThickness="1" Padding="18"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="62" Height="62" Stretch="Uniform"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="20"/><TextBlock Text="{Binding Details}" FontSize="13" Foreground="#A4987B" Margin="0,6,0,0"/></StackPanel></Grid><WrapPanel Margin="0,20,0,0"><Button Content="启用" Click="ToggleMod_Click" Padding="22,7"/><Button Content="⚙" Click="Gear_Click" ToolTip="配置 Mod" ToolTipService.InitialShowDelay="300" Padding="14,6" Background="#343229" Foreground="#E4D7AD"/></WrapPanel></StackPanel></local:RoughFrame></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></TabItem>
<TabItem Header="服务器状态"><StackPanel><TextBlock Text="营地里的幸存者" Style="{StaticResource Caption}"/><TextBlock Text="第 12 天  ·  秋  ·  2 / 6 人在线  ·  状态均为示例数据" Foreground="#A79A7B" Margin="0,0,0,26"/><ItemsControl x:Name="PlayerCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><local:RoughFrame Width="350" Margin="0,0,20,20" Background="#27271F" BorderBrush="#74684A" BorderThickness="1" Padding="18"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Height="90" Width="80" Stretch="Uniform"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="23"/><TextBlock Text="{Binding Details}" Foreground="#A4987B" FontSize="14" Margin="0,8,0,0"/></StackPanel></Grid><TextBlock Text="♥ 128 / 150    ● 106 / 150    ◐ 175 / 200" Foreground="#C1AA76" FontSize="14" Margin="0,22,0,0"/></StackPanel></local:RoughFrame></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></TabItem>
<TabItem Header="文件目录"><StackPanel><TextBlock Text="营地的行囊" Style="{StaticResource Caption}"/><TextBlock Text="目录展示仅用于参考，不读取或修改正式版的设置。" Foreground="#A79A7B" Margin="0,0,0,24"/><local:RoughFrame Background="#27271F" BorderBrush="#74684A" BorderThickness="1" Padding="18"><StackPanel><TextBlock Text="存档目录"/><TextBox Text="示例存档 / 荒野营地" IsReadOnly="True"/><TextBlock Text="服务器与创意工坊"/><TextBox Text="由正式版自动发现本机安装位置" IsReadOnly="True"/><Button Content="打开示例背包" HorizontalAlignment="Left" Click="CopyDemo_Click"/></StackPanel></local:RoughFrame></StackPanel></TabItem>
<TabItem Header="日志与诊断"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="营火边的记录" Style="{StaticResource Caption}"/><TextBlock Text="示例日志，不包含真实凭证或玩家信息。" Foreground="#A79A7B" Margin="0,0,0,24"/></StackPanel><local:RoughFrame Grid.Row="1" Background="#27271F" BorderBrush="#74684A" BorderThickness="1" Padding="18"><TextBox x:Name="DemoLogs" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0"/></local:RoughFrame></Grid></TabItem>
</TabControl>
<Border Grid.Row="2" BorderBrush="#4A432F" BorderThickness="0,1,0,0" Padding="28,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="风格参考 · 未接入真实服务器" Foreground="#9C8D69" FontSize="13"/><TextBlock x:Name="Notice" Text="欢迎来到营地。选择上方页面，看看另一种荒野风格。" Foreground="#C0B28E" FontSize="14"/></DockPanel></Border>
<Grid x:Name="Overlay" Grid.RowSpan="3" Background="#CF10110F" Visibility="Collapsed"><local:RoughFrame Width="600" VerticalAlignment="Center" Background="#29291F" Padding="30" BorderBrush="#74684A" BorderThickness="1"><StackPanel><TextBlock Text="整理你的工具" Style="{StaticResource Caption}"/><TextBlock Text="模组配置 · 交互示例" Foreground="#A79A7B" Margin="0,0,0,24"/><TextBlock Text="地图共享范围"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="所有幸存者"/><ComboBoxItem Content="仅同一世界"/></ComboBox><TextBlock Text="显示营地标记"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="启用"/><ComboBoxItem Content="停用"/></ComboBox><WrapPanel Margin="0,20,0,0"><Button Content="收好工具" Click="Dismiss_Click"/><Button Content="返回" Click="Dismiss_Click" Background="#343229" Foreground="#D6C9A6"/></WrapPanel></StackPanel></local:RoughFrame></Grid>
</Grid></Window>