<Window x:Class="SakuraCamp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="樱火营地 · 饥荒联机助手" Width="1220" Height="850" MinWidth="1050" MinHeight="720"
        Background="Transparent" Foreground="#E4E6EB" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="85" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A8AAAE"/>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#BCC7DB"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#394155"/><Setter Property="Foreground" Value="White"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#49536B"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#C94956"/><Setter Property="Foreground" Value="White"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#A83542"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#30374A"/>
            <Setter Property="Foreground" Value="#D4D6DB"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Border Background="{TemplateBinding Background}" BorderBrush="#3E4456" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="Background" Value="#363C4F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#434A5F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252A38"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="BorderBrush" Value="#3E4456"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CaretBrush" Value="#F5A962"/>
            <Setter Property="Margin" Value="0,6,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4E5668"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#F5A962"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#252A38"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="BorderBrush" Value="#3E4456"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CaretBrush" Value="#F5A962"/>
            <Setter Property="Margin" Value="0,6,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="0" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4E5668"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#F5A962"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6,0,12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
            <Setter Property="Background" Value="#252A38"/>
            <Setter Property="BorderBrush" Value="#3E4456"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Border" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="32"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ContentPresenter Grid.Column="0" Margin="12,0,0,0"
                                                                              VerticalAlignment="Center"
                                                                              HorizontalAlignment="Left"/>
                                                            <Path Grid.Column="1" HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                                  Fill="#A8AAAE"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="BorderBrush" Value="#4E5668"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#2A3041"
                                            BorderBrush="#3E4456"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Margin="0,4,0,0">
                                        <ScrollViewer Margin="4,6"
                                                      SnapsToDevicePixels="True"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto"
                                                      CanContentScroll="False">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E4E6EB"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="3"
                                            Margin="2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#363C4F"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#434A5F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D6DB"/>
            <Setter Property="Margin" Value="0,8,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="22,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#A8AAAE"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent">
                            <Border x:Name="HoverWash" Background="#343C50" CornerRadius="7,7,0,0" Opacity="0" Margin="3,2,3,3"/>
                            <Border x:Name="Tab" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"><ContentPresenter.RenderTransform><TranslateTransform x:Name="HeaderShift"/></ContentPresenter.RenderTransform></ContentPresenter>
                            </Border>
                            <Border x:Name="HoverLine" Height="3" Background="#F5A962" VerticalAlignment="Bottom" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="LineScale" ScaleX="0.35"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C8CACD"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.16"/>
                                    <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity" To="0.65" Duration="0:0:0.16"/>
                                    <DoubleAnimation Storyboard.TargetName="LineScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="HeaderShift" Storyboard.TargetProperty="Y" To="-1.5" Duration="0:0:0.16"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverWash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                    <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                    <DoubleAnimation Storyboard.TargetName="LineScale" Storyboard.TargetProperty="ScaleX" To="0.35" Duration="0:0:0.18"/>
                                    <DoubleAnimation Storyboard.TargetName="HeaderShift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#F5A962"/>
                                <Setter TargetName="Tab" Property="BorderBrush" Value="#F5A962"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#D4D6DB"/>
            <Setter Property="BorderBrush" Value="#3E4456"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,12,0,16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="#E4E6EB"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowSurface" Background="#201E2330">
        <Grid.RowDefinitions>
            <RowDefinition Height="85"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>
        <Border x:Name="TitleSurface" BorderBrush="#2D3347" BorderThickness="0,0,0,1" Padding="26,0,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40252A3A" Offset="0"/>
                    <GradientStop Color="#181E2330" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F5A962" Offset="0"/>
                                <GradientStop Color="#E89B4A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="营" Foreground="#1E2330" FontWeight="Bold" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="樱火营地" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="SAKURACAMP  /  饥荒联机助手" FontSize="10.5"
                                   Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                    <Button x:Name="MinimizeCaption" Style="{StaticResource CaptionButton}" Click="MinimizeCaption_Click" AutomationProperties.Name="最小化"><TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
                    <Button x:Name="MaximizeCaption" Style="{StaticResource CaptionButton}" Click="MaximizeCaption_Click" AutomationProperties.Name="最大化"><TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
                    <Button x:Name="CloseCaption" Style="{StaticResource CloseCaptionButton}" Click="CloseCaption_Click" AutomationProperties.Name="关闭"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/></Button>
                </StackPanel>
                <TextBlock Text="Windows 本地开服  ·  预览版 0.3.0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,17" Foreground="#8E9BB2" FontSize="11"/>
            </Grid>
        </Border>
        <Grid x:Name="WorkspaceSurface" Grid.Row="1" Margin="28,24,28,14">
                <TabControl x:Name="Tabs" SelectionChanged="ConnectionTab_Selected" Background="Transparent" BorderThickness="0" Padding="0,18,0,0">
                    <TabItem x:Name="OverviewTab" Header="世界总览">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,18">
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top"><Button Content="刷新世界" Click="Refresh_Click"/><Button Content="导入存档" Click="Import_Click" Margin="0"/></WrapPanel>
                                <StackPanel><TextBlock Text="选择开服世界" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="WorldCount" Style="{StaticResource Hint}"/><TextBlock Text="选择一张世界卡片，再前往联机设置开服。" Style="{StaticResource Hint}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                            </DockPanel>
                            <ListBox x:Name="WorldList" Grid.Row="1" SelectionChanged="WorldList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="#E4E6EB" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" HorizontalContentAlignment="Stretch">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ScrollViewer x:Name="WorldScroll" Focusable="False" Padding="{TemplateBinding Padding}">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Width" Value="350"/><Setter Property="Height" Value="174"/>
                                        <Setter Property="Margin" Value="6,0,6,12"/><Setter Property="Padding" Value="20"/><Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card" Background="#2A3041" BorderBrush="#40475B" BorderThickness="1.5" CornerRadius="13" Padding="{TemplateBinding Padding}">
                                                <Grid><ContentPresenter/><Border x:Name="SelectedBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#F5A962" CornerRadius="5" Padding="8,3" Visibility="Collapsed"><TextBlock Text="已选择" Foreground="#1E2330" FontSize="10" FontWeight="SemiBold"/></Border></Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#31394C"/><Setter TargetName="Card" Property="BorderBrush" Value="#66728B"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#F5A962"/><Setter TargetName="Card" Property="Background" Value="#343B4D"/><Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible"/></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#F5A962"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Setter.Value></Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,65,10"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#BCC7DB" Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding Mode}" FontSize="11" Foreground="#F5A962"/>
                                        <TextBlock Text="{Binding Modified, StringFormat=最近修改：{0:yyyy-MM-dd HH:mm}}" FontSize="10.5" Foreground="#8F9DB5" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="ConnectionTab" Header="联机设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ConnectPanel" Margin="0,0,14,0">
                        <Grid Margin="0,0,0,14">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <StackPanel Margin="0,0,320,0">
                        <TextBlock x:Name="WorldTitle" Text="把朋友带进同一个世界" FontSize="27" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="WorldSubtitle" Text="选择一个存档，设置一次，以后直接开服。" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="StartButton" Content="▶  一键开服" ToolTip="自动启动当前世界的樱花通道，等待通道就绪后启动世界" Background="#F5A962" Foreground="#1E2330"
                                FontWeight="Bold" Click="Start_Click" Padding="24,12" FontSize="14"/>
                        <Button x:Name="StopButton" Content="保存关服" Click="Stop_Click" IsEnabled="False" Padding="20,12"/>
                    </StackPanel>
                </Grid>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,0">
                    <Border CornerRadius="8" Padding="12" Margin="0,0,10,0" Background="#2A3041">
                        <StackPanel>
                            <TextBlock Text="地上世界" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                            <TextBlock x:Name="MasterStatus" Text="未启动" Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Padding="12" Margin="0,0,10,0" Background="#2A3041">
                        <StackPanel>
                            <TextBlock Text="洞穴世界" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                            <TextBlock x:Name="CavesStatus" Text="未启动" Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Padding="12" Margin="0" Background="#2A3041">
                        <StackPanel>
                            <TextBlock Text="樱花穿透" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                            <TextBlock x:Name="TunnelStatus" Text="随世界自动启动" Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/><TextBlock x:Name="TunnelDetail" Text="开服后自动核验官方在线状态" FontSize="11" Foreground="#A8AAAE" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
</Grid>
                        <TextBlock Text="填写樱花密钥后选择节点，即自动为此世界配置通道；更换节点会先删除本程序为此世界创建的旧通道，再创建新通道。" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                        <Grid x:Name="ConnectionFields" MaxWidth="1000" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid x:Name="ApiPanel" Grid.ColumnSpan="3">
