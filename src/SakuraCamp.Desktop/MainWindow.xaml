                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </DockPanel>
        </Border>
        <Grid x:Name="ModOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed" Background="#B0101420" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="ModOverlay_PreviewKeyDown">
            <Border x:Name="ModOverlayPanel" MaxWidth="900" Margin="40,36" Background="#1E2330" BorderBrush="#4A536B" BorderThickness="1" CornerRadius="16">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <ContentControl x:Name="ModOverlayContent" SizeChanged="ModOverlayContent_SizeChanged" Margin="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Border>
        </Grid>
    </Grid>
</Window>
